# ── Database ──────────────────────────────────────────────────────────────────
# Dev (zero-setup SQLite — no Postgres required):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
SYNC_DATABASE_URL=sqlite:///./dev.db

# Production (Postgres):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/quantum_studio
# SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/quantum_studio

# ── Redis (optional — needed for task queues in production only) ──────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── SMTP (optional — OTP verification emails) ─────────────────────────────────
# Leave blank to use terminal log output for OTP codes during development.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Quantum Studio"

# Outlook SMTP fields requested by user
SMTP_USER=
MAIL_FROM=

# ── Anthropic Claude (optional — rule-based fallback if empty) ────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get credentials at: https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origins: http://localhost:8080
# Authorised redirect URIs: (none needed for implicit flow)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Get credentials at: https://github.com/settings/applications/new
# Homepage URL:              http://localhost:8080
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# URL the backend redirects to after completing GitHub OAuth.
# Must match the origin where the frontend is running.
FRONTEND_URL=http://localhost:8080

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8080

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
MAX_QUBITS=256
