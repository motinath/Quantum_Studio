# QCLang Specification v1.0 – Five Qubit Cross (IBM-style)
# Cross/plus topology:
#        Q1
#        |
#   Q2 — Q0 — Q3
#        |
#        Q4
# Center qubit Q0 coupled to all four arm qubits.
# Each qubit has its own readout resonator with staggered frequencies.

chip:
  name: "five-qubit-cross"
  width: 10.0    # mm
  height: 10.0   # mm
  substrate: silicon

qubits:
  - id: Q0
    frequency: 5.0
    anharmonicity: -330.0
    junction:
      type: single

  - id: Q1
    frequency: 5.25
    anharmonicity: -320.0
    junction:
      type: single

  - id: Q2
    frequency: 5.1
    anharmonicity: -325.0
    junction:
      type: single

  - id: Q3
    frequency: 5.15
    anharmonicity: -322.0
    junction:
      type: single

  - id: Q4
    frequency: 5.3
    anharmonicity: -318.0
    junction:
      type: single

resonators:
  - id: R0
    frequency: 7.0
    target: Q0
    coupling_type: capacitive
    coupling_strength: 50.0

  - id: R1
    frequency: 7.2
    target: Q1
    coupling_type: capacitive
    coupling_strength: 55.0

  - id: R2
    frequency: 7.4
    target: Q2
    coupling_type: capacitive
    coupling_strength: 50.0

  - id: R3
    frequency: 7.1
    target: Q3
    coupling_type: capacitive
    coupling_strength: 52.0

  - id: R4
    frequency: 7.3
    target: Q4
    coupling_type: capacitive
    coupling_strength: 48.0

couplers:
  - id: C01
    source: Q0
    target: Q1
    strength: 4.5
    type: capacitive

  - id: C02
    source: Q0
    target: Q2
    strength: 4.5
    type: capacitive

  - id: C03
    source: Q0
    target: Q3
    strength: 4.5
    type: capacitive

  - id: C04
    source: Q0
    target: Q4
    strength: 4.5
    type: capacitive
