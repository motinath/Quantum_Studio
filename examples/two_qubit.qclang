# QCLang Specification v1.0 – Two Qubit Chip
# Two transmon qubits with a capacitive coupler and individual readout resonators.

chip:
  name: "two-qubit-chip"
  width: 10.0    # mm
  height: 10.0   # mm
  substrate: silicon

qubits:
  - id: Q0
    frequency: 5.0         # GHz
    anharmonicity: -330.0   # MHz
    junction:
      type: single

  - id: Q1
    frequency: 5.2         # GHz
    anharmonicity: -320.0   # MHz
    junction:
      type: single

resonators:
  - id: R0
    frequency: 7.0         # GHz
    target: Q0
    coupling_type: capacitive
    coupling_strength: 50.0  # MHz

  - id: R1
    frequency: 7.2         # GHz
    target: Q1
    coupling_type: capacitive
    coupling_strength: 50.0  # MHz

couplers:
  - id: C01
    source: Q0
    target: Q1
    strength: 5.0          # MHz
    type: capacitive
